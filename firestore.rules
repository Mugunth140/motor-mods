rules_version = '2';

/**
 * Firestore Security Rules for MotorMods
 * 
 * These rules allow read/write access to the products collection.
 * 
 * IMPORTANT: For production, you should add authentication and
 * restrict access based on user roles.
 * 
 * To deploy these rules:
 * 1. Go to Firebase Console > Firestore Database > Rules
 * 2. Copy and paste these rules
 * 3. Click "Publish"
 */
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products collection - used for syncing between Desktop and PWA
    match /products/{productId} {
      // Allow read access (for PWA)
      allow read: if true;
      
      // Allow write access (for Desktop app sync)
      // TODO: Add authentication check for production
      // allow write: if request.auth != null;
      allow write: if true;
    }
    
    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
